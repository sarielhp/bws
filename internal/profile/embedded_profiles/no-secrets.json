{
  "name": "no-secrets",
  "description": "Mask cloud provider credentials, GPG keyrings, and password stores",
  "mask": [
    "~/.aws",
    "~/.azure",
    "~/.config/gcloud",
    "~/.password-store",
    "~/.gnupg",
    "~/.vault-token",
    "~/.config/gh",
    "~/.git-credentials",
    "~/.config/git/credentials",
    "~/.netrc"
  ],
  "tests": [
    {
      "name": "cloud, gpg, and git secrets are masked",
      "cmd": [
        "bash",
        "-c",
        "! test -s ~/.aws/credentials && ! test -s ~/.gnupg/secring.gpg && ! test -s ~/.git-credentials && ! test -s ~/.config/gh/hosts.yml"
      ],
      "type": "smoke"
    }
  ]
}
