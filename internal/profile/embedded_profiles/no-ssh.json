{
  "name": "no-ssh",
  "description": "Block all SSH access, configuration, and host keys",
  "features": {"enable_ssh": false, "auto_repo_deploy_key": false},
  "mask": [
    "~/.ssh",
    "@@HOME@@/.ssh",
    "/etc/ssh/ssh_config",
    "/etc/ssh/ssh_config.d"
  ],
  "tests": [
    {
      "name": "ssh config is masked and empty",
      "cmd": [
        "bash",
        "-c",
        "test -z \"${SSH_AUTH_SOCK:-}\" && ! test -s ~/.ssh/config && ! test -s ~/.ssh/id_rsa"
      ],
      "type": "smoke"
    }
  ]
}
