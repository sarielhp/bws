# Print sandbox mapping configuration information
def print_info(bwrap_args, exec_args, global_config_path, local_config_path)
  puts "Bubblewrap Sandbox Configuration Information"
  puts "==========================================="
  puts ""

  rw_binds = []
  ro_binds = []
  tmpfs_binds = []
  special_mounts = []
  env_vars = {}

  i = 0
  while i < bwrap_args.length
    arg = bwrap_args[i]
    case arg
    when "--bind", "--bind-try"
      rw_binds << [bwrap_args[i+1], bwrap_args[i+2]]
      i += 3
    when "--ro-bind", "--ro-bind-try"
      ro_binds << [bwrap_args[i+1], bwrap_args[i+2]]
      i += 3
    when "--tmpfs"
      tmpfs_binds << bwrap_args[i+1]
      i += 2
    when "--proc"
      special_mounts << ["proc", bwrap_args[i+1]]
      i += 2
    when "--dev"
      special_mounts << ["dev", bwrap_args[i+1]]
      i += 2
    when "--symlink"
      special_mounts << ["symlink: #{bwrap_args[i+1]}", bwrap_args[i+2]]
      i += 3
    when "--setenv"
      env_vars[bwrap_args[i+1]] = bwrap_args[i+2]
      i += 3
    when "--unsetenv"
      env_vars[bwrap_args[i+1]] = "<unset>"
      i += 2
    else
      i += 1
    end
  end

  puts "Environment Variables:"
  env_vars.keys.sort.each do |k|
    puts "  #{k}=#{env_vars[k]}"
  end
  puts ""

  puts "Special Mounts & tmpfs:"
  special_mounts.each do |type, target|
    puts "  %-15s on %s" % [type, target]
  end
  tmpfs_binds.each do |target|
    puts "  %-15s on %s" % ["tmpfs", target]
  end
  puts ""

  puts "Read-Write Bindings (Host -> Sandbox):"
  rw_binds.each do |src, dest|
    if (src.length + dest.length + 6) > 80
      puts "  #{src}\n    -> #{dest}"
    else
      puts "  #{src} -> #{dest}"
    end
  end
  puts ""

  puts "Read-Only Bindings (Host -> Sandbox):"
  etc_binds, regular_ro_binds = ro_binds.partition { |src, dest| dest.start_with?("/etc/") }

  regular_ro_binds.each do |src, dest|
    if (src.length + dest.length + 6) > 80
      puts "  #{src}\n    -> #{dest}"
    else
      puts "  #{src} -> #{dest}"
    end
  end

  if !etc_binds.empty?
    puts "  (plus #{etc_binds.length} files from /etc/ mapped read-only individually)"
  end
  puts ""

  puts "Files/Directories Copied or Synced (Host -> Sandbox):"
  if $copied_files.empty?
    puts "  (None)"
  else
    $copied_files.each do |c|
      status = c[:copied] ? "[Copied/Updated]" : "[Up-to-date]"
      if (c[:src].length + c[:dest].length + status.length + 7) > 80
        puts "  #{c[:src]}\n    -> #{c[:dest]} #{status}"
      else
        puts "  #{c[:src]} -> #{c[:dest]} #{status}"
      end
    end
  end
  puts ""

  puts "Sandbox Command to Execute:"
  puts "  #{exec_args.join(' ')}"
  puts ""

  puts "Global Configuration File:"
  puts "  #{global_config_path}"
  puts ""

  puts "Local Configuration File:"
  if File.exist?(local_config_path)
    puts "  #{local_config_path}"
  else
    puts "  None (Not present or not loaded)"
  end
  puts ""
end

# Helper to copy file only if it is newer or missing
def copy_if_newer(src, dest)
  return unless File.file?(src)
  FileUtils.mkdir_p(File.dirname(dest))
  copied = false
  if !File.exist?(dest) || File.mtime(src) > File.mtime(dest)
    FileUtils.cp(src, dest)
    copied = true
  end
  $copied_files << { src: src, dest: dest, copied: copied }
end

# Inject oh-my-posh init configuration into shell profiles
def inject_oh_my_posh(target_file, shell_type)
  home_dir = Dir.home
  FileUtils.touch(target_file)
  content = File.read(target_file)
  unless content.include?("oh-my-posh init")
    File.open(target_file, "a") do |f|
      f.puts "\n# Initialize oh-my-posh prompt theme engine"
      f.puts "if [ -x \"#{home_dir}/bin/oh-my-posh\" ]; then"
      f.puts "  eval \"$(#{home_dir}/bin/oh-my-posh init #{shell_type} --config #{home_dir}/.mytheme.omp.json)\""
      f.puts "fi"
    end
  end
end

# Inject cdtoday function into shell profiles
def inject_cdtoday(target_file)
  FileUtils.touch(target_file)
  content = File.read(target_file)
  unless content.include?("cdtoday ()")
    File.open(target_file, "a") do |f|
      f.puts "\n# Function to navigate to today's misc directory"
      f.puts "cdtoday () {"
      f.puts "    BS=info/misc/$(date +%02y/%02m/%02d)/"
      f.puts "    DR=~/$BS"
      f.puts "    mkdir -p $DR"
      f.puts "    cd $DR"
      f.puts "    echo cd '~/'$BS"
      f.puts "}"
    end
  end
end

# Helper to bind a host file/directory to its relative path in the sandbox
def bind_path(bwrap_args, host_path, writeable: true)
  expanded_path = File.expand_path(host_path)
  return unless File.exist?(expanded_path)

  mode = writeable ? "--bind" : "--ro-bind"
  bwrap_args.concat([mode, expanded_path, expanded_path])
end

# Helper to copy configured paths into the sandbox
def process_copy_paths(copy_list, sandbox)
  return unless copy_list.is_a?(Array)

  copy_list.each do |path_str|
    expanded_path = File.expand_path(path_str)
    home = Dir.home
    if expanded_path == home || expanded_path.start_with?(home + "/")
      rel_path = expanded_path == home ? "" : expanded_path[(home.length + 1)..-1]
      sandbox_dest = File.join(sandbox, rel_path)

      if File.exist?(expanded_path)
        copied = false
        if File.directory?(expanded_path)
          FileUtils.rm_rf(sandbox_dest)
          FileUtils.mkdir_p(File.dirname(sandbox_dest))
          FileUtils.cp_r(expanded_path, sandbox_dest)
          copied = true
        else
          if !File.exist?(sandbox_dest) || File.mtime(expanded_path) > File.mtime(sandbox_dest)
            FileUtils.mkdir_p(File.dirname(sandbox_dest))
            FileUtils.cp(expanded_path, sandbox_dest)
            copied = true
          end
        end
        $copied_files << { src: expanded_path, dest: sandbox_dest, copied: copied }
      else
        warn "Warning: Path to copy does not exist: #{expanded_path}"
      end
    else
      warn "Warning: Cannot copy path outside home directory: #{expanded_path}"
    end
  end
end

# Process the directory configuration override file (.bw.jsonc)
def process_bw_jsonc(config_data, sandbox, bwrap_args)
  return unless config_data.is_a?(Hash)

  # Process "copy" array
  process_copy_paths(config_data["copy"], sandbox)


  # Process "binds_rw" array (Note: supports both directories and files)
  if config_data["binds_rw"].is_a?(Array)
    config_data["binds_rw"].each do |item|
      if item.is_a?(Array)
        host_path, sandbox_path = item
        expanded_host = File.expand_path(host_path)
        if File.exist?(expanded_host)
          bwrap_args.concat(["--bind", expanded_host, sandbox_path])
        end
      elsif item.is_a?(String)
        bind_path(bwrap_args, item, writeable: true)
      end
    end
  end

  # Process "binds_ro" array (Note: supports both directories and files)
  if config_data["binds_ro"].is_a?(Array)
    config_data["binds_ro"].each do |item|
      if item.is_a?(Array)
        host_path, sandbox_path = item
        expanded_host = File.expand_path(host_path)
        if File.exist?(expanded_host)
          bwrap_args.concat(["--ro-bind", expanded_host, sandbox_path])
        end
      elsif item.is_a?(String)
        bind_path(bwrap_args, item, writeable: false)
      end
    end
  end
end

# Handle 'scp' subcommand (scp [dest]) — copy config to remote machine
if ARGV[0] == "scp"
  dest = ARGV[1]
  if dest.nil? || dest.strip.empty?
    STDERR.puts "Error: Destination must be specified."
    STDERR.puts "Usage: bw scp <user@host:>"
    STDERR.puts "       bw scp <user@host:/path/to/dir>"
    exit 1
  end

  unless command_exists?("scp")
    STDERR.puts "Error: scp is not available on this system."
    exit 1
  end

  config_dir = File.expand_path("~/.config/bw")
  global_config = File.join(config_dir, "config.jsonc")

  unless File.exist?(global_config)
    STDERR.puts "Error: Config file not found at #{global_config}."
    exit 1
  end

  puts "Copying #{global_config} to #{dest}"
  success = system("scp", global_config, dest)
  if success
    puts "Done."
    exit 0
  else
    STDERR.puts "Error: scp failed."
    exit 1
  end
end

# Handle 'copy' subcommands (copy add [program], copy list, copy del [program])
if ARGV[0] == "copy"
  subcmd = ARGV[1]
  config_dir = File.expand_path("~/.config/bw")
  global_config_path = File.join(config_dir, "config.jsonc")

  # Ensure config file exists
  unless File.exist?(global_config_path)
    FileUtils.mkdir_p(config_dir)
    File.write(global_config_path, generate_default_config)
    example_config_path = File.join(config_dir, "example-config.jsonc")
    File.write(example_config_path, generate_example_config)
  end

  case subcmd
  when "add"
    prog = ARGV[2]
    if prog.nil? || prog.strip.empty?
      STDERR.puts "Error: Program path must be specified."
      STDERR.puts "Usage: bw copy add <full_path_to_program>"
      exit 1
    end
    unless prog.start_with?("/")
      STDERR.puts "Error: Program path must be specified as a full (absolute) path, e.g. /home/user/bin/myprog."
      exit 1
    end

    cfg = load_jsonc(global_config_path)
    cfg["copy"] ||= []
    unless cfg["copy"].is_a?(Array)
      cfg["copy"] = []
    end

    if cfg["copy"].include?(prog)
      puts "Program '#{prog}' is already in the global copy list."
    else
      cfg["copy"] << prog
      # Re-serialize JSON while keeping clean formatting
      File.write(global_config_path, JSON.pretty_generate(cfg))
      puts "Added '#{prog}' to global copy configuration (#{global_config_path})."
    end
    exit 0

  when "list"
    cfg = load_jsonc(global_config_path)
    copy_list = cfg["copy"]
    if copy_list.is_a?(Array) && !copy_list.empty?
      puts "Configured copy programs in global config (#{global_config_path}):"
      copy_list.each do |p|
        puts "  - #{p}"
      end
    else
      puts "No programs currently configured in global copy list."
    end
    exit 0

  when "del", "delete", "rm", "remove"
    prog = ARGV[2]
    if prog.nil? || prog.strip.empty?
      STDERR.puts "Error: Program path must be specified."
      STDERR.puts "Usage: bw copy del <full_path_to_program>"
      exit 1
    end

    cfg = load_jsonc(global_config_path)
    if cfg["copy"].is_a?(Array) && cfg["copy"].include?(prog)
      cfg["copy"].delete(prog)
      File.write(global_config_path, JSON.pretty_generate(cfg))
      puts "Removed '#{prog}' from global copy configuration."
    else
      STDERR.puts "Program '#{prog}' not found in global copy configuration."
      exit 1
    end
    exit 0

  else
    STDERR.puts "Unknown copy subcommand: '#{subcmd}'"
    STDERR.puts "Usage: bw copy [add <program> | list | del <program>]"
    exit 1
  end
end

# Parse command-line options
force = false
show_info = false
test_opencode = false
test_quarto = false
test_uv = false

while !ARGV.empty? && ARGV[0].start_with?("-")
  case ARGV[0]
  when "-h", "-help", "--help"
    ARGV.shift
    puts <<~HELP
      Usage: bw [options] [command [args...]]

      Bubblewrap Sandbox Launcher

      This script wraps bubblewrap (bwrap) to launch a secure, isolated sandbox
      environment with convenient bindings, shell themes, and custom configuration.

      Options:
        -h, -help, --help        Show this help message and exit
        -v, -version, --version  Show version and exit
        -f, --force              Force sandbox launch, bypassing the file count check (> 100 files)
        --info                   List all mapped files, directories, and configuration settings, then exit
        -test opencode           Start bubblewrap, run opencode, make sure it loads, and exit
        -test quarto             Start bubblewrap, run quarto, make sure it loads, and exit
        -test uv                 Start bubblewrap, verify uv and uvx load, and exit

      Copy Management Commands:
        copy add <program>       Add a program (specified by absolute path) to global config's copy list
        copy list                List all programs currently configured to be copied in global config
        copy del <program>       Remove a program from global config's copy list

      Scp Command:
        scp <dest>               Copy the global config file to a remote machine via scp
                                 (e.g. bw scp user@host:)

      Examples:
        bw                       Launch the sandbox and attach to a tmux session (default)
        bw bash                  Launch the sandbox and run bash
        bw command               Run a specific command inside the sandbox
        bw scp user@host:
        bw copy add /home/user/bin/myprog
        bw copy list
        bw copy del /home/user/bin/myprog
    HELP
    exit 0
  when "-v", "-version", "--version"
    ARGV.shift
    puts "bw version #{BW_VERSION}"
    exit 0
  when "-f", "--force"
    ARGV.shift
    force = true
  when "--info", "-info"
    ARGV.shift
    show_info = true
  when "-test", "--test"
    ARGV.shift
    target = ARGV.shift
    if target == "opencode"
      test_opencode = true
    elsif target == "quarto"
      test_quarto = true
    elsif target == "uv"
      test_uv = true
    else
      STDERR.puts "Unknown test target: '#{target}'. Supported targets: opencode, quarto, uv"
      exit 1
    end
  when "--"
    ARGV.shift
    break
  else
    break
  end
end

# Dependency validations
is_default_session = ARGV.empty? && !show_info && !test_opencode && !test_quarto && !test_uv
verify_installed_tools(is_default_tmux: is_default_session)

# Check for AppArmor / unprivileged userns restrictions
verify_bwrap_userns_support

# Run-directory security and constraint validation
current_dir = Pathname.pwd.realpath
home_dir = Pathname.new(Dir.home).realpath
home_bin_dir = home_dir + "bin"

if current_dir == home_dir || (File.directory?(home_bin_dir) && current_dir == home_bin_dir.realpath)
  STDERR.puts "Error: Running the sandbox from ~/ or ~/bin/ is blocked to prevent exposing your entire host home directory."
  exit 1
end

unless force
  file_count = count_files(current_dir.to_s, 100)
  if file_count > 100
    STDERR.puts "Error: The current directory contains more than 100 files (found #{file_count} files recursively)."
    STDERR.puts "Running bubblewrap here is blocked to prevent performance issues or accidental exposure."
    STDERR.puts "Use the -f flag to override this check (e.g., `bw -f`)."
    exit 1
  end
end

# Global Configuration File Checks and Setup
config_dir = File.expand_path("~/.config/bw")
global_config_path = File.join(config_dir, "config.jsonc")
example_config_path = File.join(config_dir, "example-config.jsonc")

unless File.exist?(global_config_path)
  FileUtils.mkdir_p(config_dir)
  File.write(global_config_path, generate_default_config)
  File.write(example_config_path, generate_example_config)
  puts "Created config file: #{global_config_path}"
  exit 0
end

# Load and parse global configuration file
puts "Loading configuration file: #{global_config_path}"
config = load_jsonc(global_config_path)
config = replace_sbox_prefix(config, Dir.home)

# Directory configuration paths
sandbox = File.expand_path("~/.sandbox/pi_generic")
FileUtils.mkdir_p(File.join(sandbox, "bin"))
FileUtils.mkdir_p(File.join(sandbox, "etc"))
FileUtils.mkdir_p(File.join(sandbox, ".pi/agent"))

# Ensure host-side tmp parent directory exists and create a unique sandbox tmp dir
FileUtils.mkdir_p("/tmp/bw")
host_tmp = Dir.mktmpdir("sandbox_", "/tmp/bw")

begin
  # Process global config "copy" list
  process_copy_paths(config["copy"], sandbox)

  # Copy models.json if it exists on host
  copy_if_newer(File.expand_path("~/info/llm/models.json"), File.join(sandbox, ".pi/agent/models.json"))

  # Copy resolv.conf (de-referencing symlink to prevent broken resolve inside sandbox)
  if File.file?("/etc/resolv.conf")
    content = File.read("/etc/resolv.conf")
    dest = File.join(sandbox, "etc/resolv.conf")
    copied = false
    if !File.exist?(dest) || File.read(dest) != content
      File.write(dest, content)
      copied = true
    end
    $copied_files << { src: "/etc/resolv.conf", dest: dest, copied: copied }
  end

  # Copy oh-my-posh if it exists on host
  copy_if_newer(File.expand_path("~/bin/oh-my-posh"), File.join(sandbox, "bin/oh-my-posh"))

  # Create oh-my-posh theme config in sandbox
  theme = {
    "version" => 4,
    "final_space" => true,
    "blocks" => [
      {
        "type" => "prompt",
        "alignment" => "left",
        "newline" => true,
        "segments" => [
          {
            "type" => "text",
            "style" => "diamond",
            "foreground" => "#ffffff",
            "background" => "#8a2be2",
            "leading_diamond" => "\u{e0b6}",
            "trailing_diamond" => "\u{e0b0}",
            "template" => " \u{2b22} BUBBLE "
          },
          {
            "type" => "session",
            "style" => "powerline",
            "powerline_symbol" => "\u{e0b0}",
            "foreground" => "#ffffff",
            "background" => "#3a3a3a",
            "template" => " {{ .UserName }}@{{ .HostName }} "
          },
          {
            "type" => "path",
            "style" => "powerline",
            "powerline_symbol" => "\u{e0b0}",
            "foreground" => "#ffffff",
            "background" => "#1c2e4a",
            "template" => " {{ .Path }} ",
            "properties" => {
              "style" => "folder"
            }
          },
          {
            "type" => "git",
            "style" => "powerline",
            "powerline_symbol" => "\u{e0b0}",
            "foreground" => "#101010",
            "background" => "#2e9599",
            "template" => " {{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }} "
          }
        ]
      }
    ]
  }
  theme_dest = File.join(sandbox, ".mytheme.omp.json")
  theme_json = JSON.pretty_generate(theme)
  copied = false
  if !File.exist?(theme_dest) || File.read(theme_dest) != theme_json
    File.write(theme_dest, theme_json)
    copied = true
  end
  $copied_files << { src: "<internal-theme-json>", dest: theme_dest, copied: copied }

  # Ensure oh-my-posh is initialized in sandbox shell profiles
  inject_oh_my_posh(File.join(sandbox, ".bashrc"), "bash")
  if File.exist?(File.join(sandbox, ".zshrc"))
    inject_oh_my_posh(File.join(sandbox, ".zshrc"), "zsh")
  end

  # Ensure custom bin paths are in PATH inside the sandbox shell configurations
  sandbox_paths = [
    "#{home_dir}/bin",
    "#{home_dir}/.local/bin",
    "#{home_dir}/.opencode/bin",
    "#{home_dir}/.cargo/bin"
  ]
  path_line = "export PATH=\"#{sandbox_paths.join(':')}:$PATH\""

  # Inject PATH, EDITOR, and VISUAL into .bashrc and .zshrc
  [".bashrc", ".zshrc"].each do |rc_name|
    rc_path = File.join(sandbox, rc_name)
    if rc_name == ".bashrc" || File.exist?(rc_path)
      FileUtils.touch(rc_path)
      content = File.read(rc_path)
      if content.include?("# Add sandbox-specific binary paths")
        new_content = content.gsub(/# Add sandbox-specific binary paths\nexport PATH=.*$/, "# Add sandbox-specific binary paths\n#{path_line}")
        File.write(rc_path, new_content) if new_content != content
      elsif !content.include?("export PATH=\"#{sandbox_paths.join(':')}:")
        File.open(rc_path, "a") do |f|
          f.puts "\n# Add sandbox-specific binary paths"
          f.puts path_line
        end
      end
      unless content.include?("export EDITOR=") || content.include?("export VISUAL=")
        File.open(rc_path, "a") do |f|
          f.puts "\n# Set default editor inside the sandbox"
          f.puts "export EDITOR=\"emacs -nw\""
          f.puts "export VISUAL=\"emacs -nw\""
        end
      end
    end
  end

  # Ensure login shells source .bashrc by creating/updating .bash_profile and .profile
  [".bash_profile", ".profile"].each do |profile_name|
    profile_path = File.join(sandbox, profile_name)
    FileUtils.touch(profile_path)
    content = File.read(profile_path)
    unless content.include?(".bashrc")
      File.open(profile_path, "a") do |f|
        f.puts "\n# Include .bashrc if it exists"
        f.puts "if [ -f \"$HOME/.bashrc\" ]; then"
        f.puts "  . \"$HOME/.bashrc\""
        f.puts "fi"
      end
    end
  end

  # Prepend startup messages to shell configuration files
  prepend_message(File.join(sandbox, ".bashrc"), "Running ~/.bashrc...")
  prepend_message(File.join(sandbox, ".profile"), "Running ~/.profile...")
  prepend_message(File.join(sandbox, ".bash_profile"), "Running ~/.bash_profile...")
  if File.exist?(File.join(sandbox, ".zshrc"))
    prepend_message(File.join(sandbox, ".zshrc"), "Running ~/.zshrc...")
  end

  # Set up .tmux.conf in the sandbox (copy host config as base if newer or missing, then append status indicator)
  tmux_conf = File.join(sandbox, ".tmux.conf")
  host_tmux = File.expand_path("~/.tmux.conf")
  needs_bubble = false

  if File.file?(host_tmux)
    copied = false
    if !File.exist?(tmux_conf) || File.mtime(host_tmux) > File.mtime(tmux_conf)
      FileUtils.cp(host_tmux, tmux_conf)
      FileUtils.chmod("+w", tmux_conf)
      needs_bubble = true
      copied = true
    end
    $copied_files << { src: host_tmux, dest: tmux_conf, copied: copied }
  elsif !File.exist?(tmux_conf)
    FileUtils.touch(tmux_conf)
    FileUtils.chmod("+w", tmux_conf)
    needs_bubble = true
    $copied_files << { src: "<empty>", dest: tmux_conf, copied: true }
  end

  if needs_bubble || (File.exist?(tmux_conf) && !File.read(tmux_conf).include?("BUBBLE"))
    FileUtils.chmod("+w", tmux_conf)
    File.open(tmux_conf, "a") do |f|
      f.puts "\n# Sandbox indicator in status bar"
      f.puts "set -g status-left-length 20"
      f.puts "set -g status-left \"#[fg=white,bg=purple,bold] BUBBLE #[default] \""
      f.puts "set -g status-style bg=colour234,fg=colour137"
    end
  end

  # Ensure cdtoday function is defined in the sandbox's shell configurations
  inject_cdtoday(File.join(sandbox, ".bashrc"))
  if File.exist?(File.join(sandbox, ".zshrc"))
    inject_cdtoday(File.join(sandbox, ".zshrc"))
  end

  # Base bubblewrap arguments initialized dynamically from the parsed configuration
  bwrap_args = ["--tmpfs", "/etc"]

  # 1. Parse system flags
  if config["system"]
    bwrap_args << "--share-net" if config["system"]["share_net"]
    bwrap_args << "--clearenv" if config["system"]["clearenv"]
    bwrap_args << "--unshare-uts" if config["system"]["unshare_uts"]
    if config["system"]["hostname"]
      bwrap_args.concat(["--hostname", config["system"]["hostname"]])
    end
  end

  # 2. Parse binds_rw
  if config["binds_rw"].is_a?(Array)
    config["binds_rw"].each do |item|
      if item.is_a?(Array)
        host_path, sandbox_path = item
        expanded_host = File.expand_path(host_path)
        if File.exist?(expanded_host)
          bwrap_args.concat(["--bind", expanded_host, sandbox_path])
        end
      elsif item.is_a?(String)
        bind_path(bwrap_args, item, writeable: true)
      end
    end
  end

  # 3. Parse binds_ro
  if config["binds_ro"].is_a?(Array)
    config["binds_ro"].each do |item|
      if item.is_a?(Array)
        host_path, sandbox_path = item
        expanded_host = File.expand_path(host_path)
        if File.exist?(expanded_host)
          bwrap_args.concat(["--ro-bind", expanded_host, sandbox_path])
        end
      elsif item.is_a?(String)
        bind_path(bwrap_args, item, writeable: false)
      end
    end
  end

  # 4. Parse environment variables
  if config["env"].is_a?(Hash)
    config["env"].each do |k, default_val|
      val = (ENV[k] && !ENV[k].empty?) ? ENV[k] : default_val
      if k == "LC_ALL" && (!ENV["LC_ALL"] || ENV["LC_ALL"].empty?)
        val = ENV["LANG"] || default_val
      elsif k == "LOGNAME" && (!ENV["LOGNAME"] || ENV["LOGNAME"].empty?)
        val = ENV["USER"] || default_val
      end
      if val && !val.empty?
        bwrap_args.concat(["--setenv", k, val])
      end
    end
  end

  # Pass OPENROUTER_API_KEY from host environment if present and not already handled in config["env"]
  if ENV["OPENROUTER_API_KEY"] && !ENV["OPENROUTER_API_KEY"].empty? && (!config["env"].is_a?(Hash) || !config["env"].key?("OPENROUTER_API_KEY"))
    bwrap_args.concat(["--setenv", "OPENROUTER_API_KEY", ENV["OPENROUTER_API_KEY"]])
  end

  # 5. Parse and concatenate PATH directories
  if config["path"].is_a?(Array)
    resolved_paths = config["path"].map do |p|
      p.start_with?("~") ? p.gsub(/^~/, home_dir.to_s) : p
    end
    bwrap_args.concat(["--setenv", "PATH", resolved_paths.join(":")])
  end

  # 6. Parse features (SSH, X11, automatic ETC mapping)
  if config["features"]
    if config["features"]["enable_ssh"]
      ssh_keys = config["features"]["ssh_keys"]
      if (ssh_keys.nil? || ssh_keys.empty?) && config["features"].fetch("auto_repo_deploy_key", true)
        auto_key = get_auto_deploy_key
        ssh_keys = [auto_key] if auto_key
      end
      ssh_auth_sock = ensure_ssh_agent(ssh_keys)
      host_ssh_dir = File.expand_path("~/.ssh")
      sandbox_ssh = "#{home_dir}/.ssh"

      if ssh_auth_sock && File.socket?(ssh_auth_sock)
        # Safe method: Forward SSH agent socket only. Private key files are NOT exposed.
        bwrap_args.concat(["--bind", ssh_auth_sock, ssh_auth_sock])
        bwrap_args.concat(["--setenv", "SSH_AUTH_SOCK", ssh_auth_sock])

        # Bind non-secret config and known_hosts files if they exist
        if File.directory?(host_ssh_dir)
          FileUtils.mkdir_p(File.join(sandbox, ".ssh"))
          ["config", "known_hosts"].each do |f|
            host_f = File.join(host_ssh_dir, f)
            if File.exist?(host_f)
              bwrap_args.concat(["--bind", host_f, "#{sandbox_ssh}/#{f}"])
            end
          end
        end
      elsif File.directory?(host_ssh_dir)
        # Fallback method when ssh-agent is not running: mount ~/.ssh read-only
        bwrap_args.concat(["--ro-bind", host_ssh_dir, sandbox_ssh])
        known_hosts = File.join(host_ssh_dir, "known_hosts")
        if File.exist?(known_hosts)
          bwrap_args.concat(["--bind", known_hosts, "#{sandbox_ssh}/known_hosts"])
        end
      end
    end

    if config["features"]["enable_x11"]
      display = ENV["DISPLAY"]
      if display
        bwrap_args.concat(["--setenv", "DISPLAY", display])
        bwrap_args.concat(["--ro-bind-try", "/tmp/.X11-unix", "/tmp/.X11-unix"])

        xauth = ENV["XAUTHORITY"] || File.expand_path("~/.Xauthority")
        if File.exist?(xauth)
          bwrap_args.concat(["--ro-bind", xauth, "#{home_dir}/.Xauthority"])
          bwrap_args.concat(["--setenv", "XAUTHORITY", "#{home_dir}/.Xauthority"])
        end

        # Bind user XDG runtime directory (/run/user/UID) for DBus, AT-SPI, and GTK/Qt GUI sockets
        uid = Process.uid
        user_run_dir = ENV['XDG_RUNTIME_DIR'] || "/run/user/#{uid}"
        if Dir.exist?(user_run_dir)
          bwrap_args.concat(["--bind-try", user_run_dir, user_run_dir])
          bwrap_args.concat(["--setenv", "XDG_RUNTIME_DIR", user_run_dir])
        end

        # Suppress GTK accessibility bus connection warnings
        bwrap_args.concat(["--setenv", "NO_AT_SPI", "1"])
      end
    end

    if config["features"]["enable_etc_auto_bind"]
      Dir.glob("/etc/*").each do |item|
        filename = File.basename(item)
        if filename != "resolv.conf"
          bwrap_args.concat(["--ro-bind-try", item, "/etc/#{filename}"])
        end
      end
    end
  end

  # Auto-bind /opt and Quarto installation path if available on host
  if File.exist?("/opt")
    bwrap_args.concat(["--ro-bind-try", "/opt", "/opt"])
    opt_real = File.realpath("/opt") rescue "/opt"
    if opt_real != "/opt" && File.exist?(opt_real)
      bwrap_args.concat(["--ro-bind-try", opt_real, opt_real])
    end
  end

  if command_exists?("quarto")
    quarto_cmd = `which quarto 2>/dev/null`.strip
    if !quarto_cmd.empty? && File.exist?(quarto_cmd)
      real_path = File.realpath(quarto_cmd) rescue quarto_cmd
      quarto_bin_dir = File.dirname(real_path)
      quarto_root = File.dirname(quarto_bin_dir)
      if File.directory?(quarto_root) && !bwrap_args.include?(quarto_root)
        bwrap_args.concat(["--ro-bind-try", quarto_root, quarto_root])
      end
      if File.directory?(quarto_bin_dir) && !bwrap_args.include?(quarto_bin_dir)
        bwrap_args.concat(["--ro-bind-try", quarto_bin_dir, quarto_bin_dir])
      end
    end
  end

  # Calculate sandbox PWD relative to host PWD
  sandbox_pwd = current_dir.to_s

  # Bind sandbox PWD and general temp/special files
  bwrap_args.concat([
    "--bind", host_tmp, "/tmp",
    "--proc", "/proc",
    "--dev", "/dev",
    "--die-with-parent",
    "--bind", current_dir.to_s, sandbox_pwd,
    "--chdir", sandbox_pwd
  ])

  # Bind the custom resolv.conf into the writeable /etc tmpfs
  sandbox_resolv = File.join(sandbox, "etc/resolv.conf")
  if File.file?(sandbox_resolv)
    bwrap_args.concat(["--ro-bind", sandbox_resolv, "/etc/resolv.conf"])
  end

  # Load and process the local directory configuration (.bw.jsonc) if it exists
  local_config_path = File.join(current_dir.to_s, ".bw.jsonc")
  if File.exist?(local_config_path)
    puts "Loading configuration file: #{local_config_path}"
    local_config = load_jsonc(local_config_path)
    local_config = replace_sbox_prefix(local_config, Dir.home)
    process_bw_jsonc(local_config, sandbox, bwrap_args)
  end

  # Execution arguments logic
  exec_args = if test_opencode
                ["opencode", "debug", "info"]
              elsif test_quarto
                ["quarto", "--version"]
              elsif test_uv
                ["uv", "--version"]
              elsif ARGV.empty?
                # Force tmux to run in UTF-8 mode (-u) to prevent line-wrapping/overwrite glitches
                ["tmux", "-u", "new-session", "-A", "-s", "bwrap-dev"]
              else
                ARGV
              end

  # Run bubblewrap with the assembled arguments
  if show_info
    print_info(bwrap_args, exec_args, global_config_path, local_config_path)
    exit 0
  end

  if test_opencode
    require 'open3'
    output, status = Open3.capture2e("bwrap", *bwrap_args, *exec_args)
    if status.success?
      puts "Everything is fine."
      exit 0
    else
      STDERR.puts "Test failed: opencode did not load correctly."
      STDERR.puts "Detail:"
      STDERR.puts output
      exit status.exitstatus || 1
    end
  elsif test_quarto
    require 'open3'
    output, status = Open3.capture2e("bwrap", *bwrap_args, *exec_args)
    if status.success?
      puts "Quarto version inside sandbox: #{output.strip}"
      puts "Everything is fine."
      exit 0
    else
      STDERR.puts "Test failed: quarto did not load correctly."
      STDERR.puts "Detail:"
      STDERR.puts output
      exit status.exitstatus || 1
    end
  elsif test_uv
    require 'open3'
    output_uv, status_uv = Open3.capture2e("bwrap", *bwrap_args, "uv", "--version")
    output_uvx, status_uvx = Open3.capture2e("bwrap", *bwrap_args, "uvx", "--version")
    if status_uv.success? && status_uvx.success?
      puts "uv version inside sandbox: #{output_uv.strip}"
      puts "uvx version inside sandbox: #{output_uvx.strip}"
      puts "Everything is fine."
      exit 0
    else
      STDERR.puts "Test failed: uv or uvx did not load correctly."
      STDERR.puts "uv output: #{output_uv}" unless status_uv.success?
      STDERR.puts "uvx output: #{output_uvx}" unless status_uvx.success?
      exit(status_uv.exitstatus || status_uvx.exitstatus || 1)
    end
  else
    success = system("bwrap", *bwrap_args, *exec_args)
    exit_code = success ? 0 : ($?.exitstatus || 1)
    exit exit_code
  end

ensure
  # Clean up host temporary directory
  FileUtils.rm_rf(host_tmp) if host_tmp && Dir.exist?(host_tmp)
end


