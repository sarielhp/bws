  home_dir = Dir.home
  user_name = ENV['USER'] || 'user'
  logname = ENV['LOGNAME'] || user_name
  sandbox_dir = "~/.sandbox/pi_generic"
  <<~JSONC
    // Bubblewrap Sandbox Launcher Configuration File
    // 
    // This file configures the global settings, mounts, environment variables,
    // and paths used when launching the bubblewrap sandbox.
    // 
    // All system paths (binds_rw and binds_ro) support both files and directories.

    {
      // System flags passed to bubblewrap (bwrap)
      "system": {
        "share_net": true,
        "clearenv": true,
        "unshare_uts": true,
        "hostname": "bubble"
      },

      // Sandbox backing directory (persistent home) on the host.
      // NOTE: if you change this, also update the matching "Persistent home" bind in binds_rw.
      "sandbox_path": "#{sandbox_dir}",

      // Host path to the LLM models.json file copied into the sandbox
      "models_json_path": "~/info/llm/models.json",

      // tmux session name used for the default interactive session
      "tmux_session_name": "bwrap-dev",

      // Maximum number of files allowed in the launch directory before running is blocked
      "max_file_count": 100,

      // Base directory (relative to home) the generated `cdtoday` shell function navigates to
      "cdtoday": "info/misc",

      // Sandbox features that dynamically configure elements based on the host
      "features": {
        // Enable mounting the active host SSH authentication socket if it exists
        "enable_ssh": true,
        // Optional: explicit SSH private key paths to load into the agent (empty = default keys)
        "ssh_keys": [],
