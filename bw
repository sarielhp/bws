# Print sandbox mapping configuration information
def print_info(bwrap_args, exec_args, global_config_path, local_config_path, configured_copy = [], system_config = nil, default_chdir = nil)
  puts "Bubblewrap Sandbox Configuration Information"
  puts "==========================================="
  puts ""

  rw_binds = []
  ro_binds = []
  tmpfs_binds = []
  special_mounts = []
  env_vars = {}
  flags = []
  hostname = nil
  chdir = nil

  i = 0
  while i < bwrap_args.length
    arg = bwrap_args[i]
    case arg
    when "--bind", "--bind-try"
      rw_binds << [bwrap_args[i+1], bwrap_args[i+2]]
      i += 3
    when "--ro-bind", "--ro-bind-try"
      ro_binds << [bwrap_args[i+1], bwrap_args[i+2]]
      i += 3
    when "--tmpfs"
      tmpfs_binds << bwrap_args[i+1]
      i += 2
    when "--proc"
      special_mounts << ["proc", bwrap_args[i+1]]
      i += 2
    when "--dev"
      special_mounts << ["dev", bwrap_args[i+1]]
      i += 2
    when "--symlink"
      special_mounts << ["symlink: #{bwrap_args[i+1]}", bwrap_args[i+2]]
      i += 3
    when "--setenv"
      env_vars[bwrap_args[i+1]] = bwrap_args[i+2]
      i += 3
    when "--unsetenv"
      env_vars[bwrap_args[i+1]] = "<unset>"
      i += 2
    when "--hostname"
      hostname = bwrap_args[i+1]
      i += 2
    when "--chdir"
      chdir = bwrap_args[i+1]
      i += 2
    when "--share-net", "--clearenv", "--unshare-uts", "--die-with-parent"
      flags << arg
      i += 1
    else
      i += 1
    end
  end

  puts "Environment Variables:"
  env_vars.keys.sort.each do |k|
    puts "  #{k}=#{env_vars[k]}"
  end
  puts ""

  puts "System / Sandbox Flags:"
  # Prefer the authoritative values parsed from bwrap_args; merge in config-derived
  # system settings so the report cannot drift from the real bwrap invocation.
  if system_config.is_a?(Hash)
    flags << "--share-net" if system_config["share_net"] && !flags.include?("--share-net")
    flags << "--clearenv" if system_config["clearenv"] && !flags.include?("--clearenv")
    flags << "--unshare-uts" if system_config["unshare_uts"] && !flags.include?("--unshare-uts")
    hostname ||= system_config["hostname"] if system_config["hostname"]
  end
  flags << "--die-with-parent" unless flags.include?("--die-with-parent")
  chdir = default_chdir.to_s if chdir.nil? && default_chdir
  puts "  #{flags.sort.join(', ')}" unless flags.empty?
  puts "  hostname: #{hostname}" if hostname
  puts "  chdir (working directory): #{chdir}" if chdir
  puts ""

  puts "Special Mounts & tmpfs:"
  special_mounts.each do |type, target|
    puts "  %-15s on %s" % [type, target]
  end
  tmpfs_binds.each do |target|
    puts "  %-15s on %s" % ["tmpfs", target]
  end
  puts ""

  puts "Read-Write Bindings (Host -> Sandbox):"
  rw_binds.each do |src, dest|
    if (src.length + dest.length + 6) > 80
      puts "  #{src}\n    -> #{dest}"
    else
      puts "  #{src} -> #{dest}"
    end
  end
  puts ""

  puts "Read-Only Bindings (Host -> Sandbox):"
  etc_binds, regular_ro_binds = ro_binds.partition { |src, dest| dest.start_with?("/etc/") }

  regular_ro_binds.each do |src, dest|
    if (src.length + dest.length + 6) > 80
      puts "  #{src}\n    -> #{dest}"
    else
      puts "  #{src} -> #{dest}"
    end
  end

  if !etc_binds.empty?
    puts "  (plus #{etc_binds.length} files from /etc/ mapped read-only individually)"
  end
  puts ""

  puts "Files/Directories Copied or Synced (Host -> Sandbox):"
  if $copied_files.empty?
    if configured_copy.empty?
      puts "  (None)"
    else
      puts "  (dry run -- copying skipped; #{configured_copy.length} path(s) configured:)"
      configured_copy.each do |src|
        puts "  #{src}"
      end
    end
  else
    $copied_files.each do |c|
      status = c[:copied] ? "[Copied/Updated]" : "[Up-to-date]"
      if (c[:src].length + c[:dest].length + status.length + 7) > 80
        puts "  #{c[:src]}\n    -> #{c[:dest]} #{status}"
      else
        puts "  #{c[:src]} -> #{c[:dest]} #{status}"
      end
    end
  end
  puts ""

  puts "Sandbox Command to Execute:"
  puts "  #{exec_args.join(' ')}"
  puts ""

  puts "Global Configuration File:"
  puts "  #{global_config_path}"
  puts ""

  puts "Local Configuration File:"
  if File.exist?(local_config_path)
    puts "  #{local_config_path}"
  else
    puts "  None (Not present or not loaded)"
  end
  puts ""
end

# Helper to copy file only if it is newer or missing
def copy_if_newer(src, dest)
  return unless File.file?(src)
  FileUtils.mkdir_p(File.dirname(dest))
  copied = false
  if !File.exist?(dest) || File.mtime(src) > File.mtime(dest)
    FileUtils.cp(src, dest)
    copied = true
  end
  $copied_files << { src: src, dest: dest, copied: copied }
end

# Inject oh-my-posh init configuration into shell profiles. Idempotent: any previously
# injected block is replaced in place so the profile never accumulates stale content.
def inject_oh_my_posh(target_file, shell_type, theme_path)
  home_dir = Dir.home
  FileUtils.touch(target_file)
  content = File.read(target_file)
  content = content.sub(/# Initialize oh-my-posh prompt theme engine\n.*?\nfi\n?/m, "")
  block =
    "if command -v oh-my-posh >/dev/null 2>&1; then\n" \
    "  eval \"$(oh-my-posh init #{shell_type} --config #{theme_path})\"\n" \
    "elif [ -x \"#{home_dir}/bin/oh-my-posh\" ]; then\n" \
    "  eval \"$(#{home_dir}/bin/oh-my-posh init #{shell_type} --config #{theme_path})\"\n" \
    "fi\n"
  unless content.include?("oh-my-posh init")
    File.write(target_file, content + "\n# Initialize oh-my-posh prompt theme engine\n" + block)
  end
end

# Inject cdtoday function into shell profiles. Idempotent: a previous block is removed
# before (re-)appending, so config changes apply in place instead of accumulating.
def inject_cdtoday(target_file, base_dir = "info/misc")
  base = base_dir.to_s.delete_suffix("/")
  FileUtils.touch(target_file)
  content = File.read(target_file)
  content = content.sub(/^cdtoday \(\) \{\n(?:.*\n)*?\}\n?/m, "")
  block =
    "cdtoday () {\n" \
    "    BS=#{base}/$(date +%02y/%02m/%02d)/\n" \
    "    DR=~/$BS\n" \
    "    mkdir -p $DR\n" \
    "    cd $DR\n" \
    "    echo cd '~/'$BS\n" \
    "}\n"
  unless content.include?("cdtoday ()")
    File.write(target_file, content + "\n# Function to navigate to today's #{base} directory\n" + block)
  end
end

# Helper to bind a host file/directory to its relative path in the sandbox
def bind_path(bwrap_args, host_path, writeable: true)
  expanded_path = File.expand_path(host_path)
  return unless File.exist?(expanded_path)

  mode = writeable ? "--bind" : "--ro-bind"
  bwrap_args.concat([mode, expanded_path, expanded_path])
end

# Helper to copy configured paths into the sandbox
def process_copy_paths(copy_list, sandbox)
  return unless copy_list.is_a?(Array)

  copy_list.each do |path_str|
    expanded_path = File.expand_path(path_str)
    home = Dir.home
    # Reject the home directory itself (and its .sandbox backing store): copying it would
    # delete the sandbox root and recursively copy the entire home into it.
    if expanded_path == home || expanded_path.start_with?(home + "/.sandbox")
      warn "Warning: Refusing to copy home directory or sandbox backing store: #{expanded_path}"
      next
    end
    if expanded_path.start_with?(home + "/")
      rel_path = expanded_path[(home.length + 1)..-1]
      sandbox_dest = File.join(sandbox, rel_path)

      if File.exist?(expanded_path)
        copied = false
        if File.directory?(expanded_path)
          FileUtils.rm_rf(sandbox_dest)
          FileUtils.mkdir_p(File.dirname(sandbox_dest))
          FileUtils.cp_r(expanded_path, sandbox_dest)
          copied = true
        else
          if !File.exist?(sandbox_dest) || File.mtime(expanded_path) > File.mtime(sandbox_dest)
            FileUtils.mkdir_p(File.dirname(sandbox_dest))
            FileUtils.cp(expanded_path, sandbox_dest)
            copied = true
          end
        end
        $copied_files << { src: expanded_path, dest: sandbox_dest, copied: copied }
      else
        warn "Warning: Path to copy does not exist: #{expanded_path}"
      end
    else
      warn "Warning: Cannot copy path outside home directory: #{expanded_path}"
    end
  end
end

# Apply a config binds_rw / binds_ro array (of [host, sandbox] pairs or bare host
# paths) onto the bwrap argument list. Shared by the global config and .bw.jsonc.
def apply_binds_list(bwrap_args, list, ro: false)
  return unless list.is_a?(Array)
  mode = ro ? "--ro-bind" : "--bind"
  list.each do |item|
    if item.is_a?(Array)
      host_path, sandbox_path = item
      next unless host_path && sandbox_path
      expanded_host = File.expand_path(host_path)
      next unless File.exist?(expanded_host)
      bwrap_args.concat([mode, expanded_host, sandbox_path])
    elsif item.is_a?(String)
      bind_path(bwrap_args, item, writeable: !ro)
    end
  end
end

# Process the directory configuration override file (.bw.jsonc)
def process_bw_jsonc(config_data, sandbox, bwrap_args, dry_run: false)
  return unless config_data.is_a?(Hash)

  # Process "copy" array (side-effecting: skipped during a --info dry run)
  process_copy_paths(config_data["copy"], sandbox) unless dry_run

  # Process "binds_rw" and "binds_ro" arrays (support both directories and files)
  apply_binds_list(bwrap_args, config_data["binds_rw"], ro: false)
  apply_binds_list(bwrap_args, config_data["binds_ro"], ro: true)
end

# Locate the bounds (offsets of the '[' and ']') of a top-level JSON key's array value,
# honoring string literals and single-line // comments so comments never break bracket matching.
def jsonc_array_bounds(text, key)
  m = /"#{Regexp.escape(key)}"\s*:/.match(text)
  return nil unless m
  open_idx = text.index("[", m.begin(0))
  return nil unless open_idx
  depth = 0
  in_str = false
  in_comment = false
  i = open_idx
  while i < text.length
    c = text[i]
    nxt = text[i + 1]
    if in_comment
      in_comment = false if c == "\n"
    elsif in_str
      if c == "\\"
        i += 1
      elsif c == '"'
        in_str = false
      end
    else
      if c == "/" && nxt == "/"
        in_comment = true
        i += 1
      elsif c == '"'
        in_str = true
      elsif c == "["
        depth += 1
      elsif c == "]"
        depth -= 1
        return [open_idx, i] if depth <= 0
      end
    end
    i += 1
  end
  nil
end

# Rewrite only the top-level "copy" array (or append it if absent), preserving all
# JSONC comments and formatting elsewhere in the file. This avoids the data loss that
# would result from re-serializing the whole document with JSON.pretty_generate.
def set_copy_array(text, elements)
  if (bounds = jsonc_array_bounds(text, "copy"))
    open_idx, close_idx = bounds
    # text[0...open_idx] already includes '"copy": ' up to the '[', so only the
    # array body is regenerated here.
    inner_block = if elements.empty?
                    "[]"
                  else
                    body = elements.map { |e| "    #{JSON.generate(e)}" }.join(",\n")
                    "[\n#{body}\n  ]"
                  end
    text[0...open_idx] + inner_block + text[(close_idx + 1)..]
  else
    last = text.rindex("}")
    return text unless last
    elements_block = elements.map { |e| "    #{JSON.generate(e)}" }.join(",\n")
    # Insert as a new top-level member, adding the required trailing comma after
    # the previous last member (the closing bracket just before the final brace).
    head = text[0...last].rstrip.sub(/(\]|\})(\s*)\z/, '\1,')
    section = "\n\n  // Programs copied into the sandbox\n  \"copy\": [\n#{elements_block}\n  ]\n"
    head + section + text[last..]
  end
end

# Handle the non-option subcommands. Dispatched here (before the sandbox option parser)
# because they are exclusive one-shot operations that must exit before sandbox setup runs.
case ARGV[0]
when "scp"
  dest = ARGV[1]
  if dest.nil? || dest.strip.empty?
    STDERR.puts "Error: Destination must be specified."
    STDERR.puts "Usage: bw scp <user@host:>"
    STDERR.puts "       bw scp <user@host:/path/to/dir>"
    exit 1
  end

  unless command_exists?("scp")
    STDERR.puts "Error: scp is not available on this system."
    exit 1
  end

  config_dir = File.expand_path("~/.config/bw")
  global_config = File.join(config_dir, "config.jsonc")

  unless File.exist?(global_config)
    STDERR.puts "Error: Config file not found at #{global_config}."
    exit 1
  end

  theme_file = File.join(config_dir, "theme.omp.json")
  files_to_scp = [global_config]
  files_to_scp << theme_file if File.exist?(theme_file)

  puts "Copying #{files_to_scp.join(', ')} to #{dest}"
  success = system("scp", *files_to_scp, dest)
  if success
    puts "Done."
    exit 0
  else
    STDERR.puts "Error: scp failed."
    exit 1
  end

# Handle 'copy' subcommands (copy add [program], copy list, copy del [program])
when "copy"
  subcmd = ARGV[1]
  config_dir = File.expand_path("~/.config/bw")
  global_config_path = File.join(config_dir, "config.jsonc")

  # Ensure config file exists
  unless File.exist?(global_config_path)
    FileUtils.mkdir_p(config_dir)
    File.write(global_config_path, generate_default_config)
    example_config_path = File.join(config_dir, "example-config.jsonc")
    File.write(example_config_path, generate_example_config)
    theme_config_path = File.join(config_dir, "theme.omp.json")
    File.write(theme_config_path, generate_default_theme) unless File.exist?(theme_config_path)
  end

  case subcmd
  when "add"
    prog = ARGV[2]
    if prog.nil? || prog.strip.empty?
      STDERR.puts "Error: Program path must be specified."
      STDERR.puts "Usage: bw copy add <full_path_to_program>"
      exit 1
    end
    unless prog.start_with?("/")
      STDERR.puts "Error: Program path must be specified as a full (absolute) path, e.g. /home/user/bin/myprog."
      exit 1
    end

    home_dir = File.expand_path("~")
    expanded = File.expand_path(prog)
    unless expanded.start_with?(home_dir + "/") && !expanded.start_with?(home_dir + "/.sandbox")
      STDERR.puts "Error: Program must be inside your home directory (#{home_dir}) and not the sandbox backing store (/.sandbox)."
      exit 1
    end

    cfg = load_jsonc(global_config_path)
    copy_list = cfg["copy"].is_a?(Array) ? cfg["copy"] : []

    if copy_list.include?(prog)
      puts "Program '#{prog}' is already in the global copy list."
    else
      text = File.read(global_config_path)
      File.write(global_config_path, set_copy_array(text, copy_list + [prog]))
      puts "Added '#{prog}' to global copy configuration (#{global_config_path})."
    end
    exit 0

  when "list"
    cfg = load_jsonc(global_config_path)
    copy_list = cfg["copy"]
    if copy_list.is_a?(Array) && !copy_list.empty?
      puts "Configured copy programs in global config (#{global_config_path}):"
      copy_list.each do |p|
        puts "  - #{p}"
      end
    else
      puts "No programs currently configured in global copy list."
    end
    exit 0

  when "del", "delete", "rm", "remove"
    prog = ARGV[2]
    if prog.nil? || prog.strip.empty?
      STDERR.puts "Error: Program path must be specified."
      STDERR.puts "Usage: bw copy del <full_path_to_program>"
      exit 1
    end

    cfg = load_jsonc(global_config_path)
    if cfg["copy"].is_a?(Array) && cfg["copy"].include?(prog)
      text = File.read(global_config_path)
      File.write(global_config_path, set_copy_array(text, cfg["copy"] - [prog]))
      puts "Removed '#{prog}' from global copy configuration."
    else
      STDERR.puts "Program '#{prog}' not found in global copy configuration."
      exit 1
    end
    exit 0

  else
    STDERR.puts "Unknown copy subcommand: '#{subcmd}'"
    STDERR.puts "Usage: bw copy [add <program> | list | del <program>]"
    exit 1
  end
end

