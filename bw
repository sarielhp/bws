#!/usr/bin/env ruby
#
# Bubblewrap Sandbox Launcher
#
# This script wraps bubblewrap (bwrap) to launch a secure, isolated sandbox
# environment with convenient bindings, shell themes, and custom configuration.
#
# Added features:
# - Global config file support (~/.config/bw/config.jsonc) with dynamic feature toggles.
# - Local directory-level override config support (.bw.jsonc).
# - Safety checks preventing run from ~/ or ~/bin/, or directories with > 100 files.
# - Force option (-f) to bypass file count check.
#

BW_VERSION = "0.1.0"

require 'fileutils'
require 'pathname'
require 'tmpdir'
require 'find'
require 'json'

# Track files copied/synced to the sandbox
$copied_files = []

# Helper to recursively count files in a directory up to a limit
def count_files(dir, limit = 100)
  count = 0
  begin
    Find.find(dir) do |path|
      if File.basename(path) == '.git'
        Find.prune
      elsif File.file?(path)
        count += 1
        return count if count > limit
      end
    end
  rescue Errno::EACCES, Errno::ENOENT
    # Ignore files we cannot access
  end
  count
end

# Helper to check if a command exists in the host PATH
def command_exists?(cmd)
  ENV['PATH'].split(File::PATH_SEPARATOR).any? do |dir|
    file = File.join(dir, cmd)
    File.file?(file) && File.executable?(file)
  end
end

# Helper to ensure an active SSH agent on the host, automatically starting one and adding specified/default keys
def ensure_ssh_agent(specific_keys = nil)
  sock = ENV["SSH_AUTH_SOCK"]
  return sock if sock && File.socket?(sock)

  return nil unless command_exists?("ssh-agent") && command_exists?("ssh-add")

  agent_dir = File.expand_path("~/.sandbox")
  FileUtils.mkdir_p(agent_dir)
  agent_sock = File.join(agent_dir, "ssh_agent.sock")

  if File.socket?(agent_sock)
    # Probe the socket: `ssh-add -l` exits 0 if the agent holds keys, 1 if the agent is
    # alive but empty -- both mean the agent is functional and safe to reuse. Any other
    # exit (e.g. 2 = "could not open connection") means the socket is stale, so discard it.
    `SSH_AUTH_SOCK="#{agent_sock}" ssh-add -l >/dev/null 2>&1`
    if $?.exitstatus == 0 || $?.exitstatus == 1
      ENV["SSH_AUTH_SOCK"] = agent_sock
      if specific_keys.is_a?(Array) && !specific_keys.empty?
        system("SSH_AUTH_SOCK=\"#{agent_sock}\" ssh-add -D >/dev/null 2>&1")
        specific_keys.each do |k|
          exp_k = File.expand_path(k)
          if File.file?(exp_k)
            system("SSH_AUTH_SOCK=\"#{agent_sock}\" ssh-add \"#{exp_k}\" >/dev/null 2>&1")
          end
        end
      else
        # Reused agent was empty/no specific keys requested: load the user's default keys,
        # matching the behavior of a freshly spawned agent below.
        system("SSH_AUTH_SOCK=\"#{agent_sock}\" ssh-add >/dev/null 2>&1")
      end
      return agent_sock
    else
      FileUtils.rm_f(agent_sock)
    end
  end

  if system("ssh-agent -a \"#{agent_sock}\" >/dev/null 2>&1")
    ENV["SSH_AUTH_SOCK"] = agent_sock
    if specific_keys.is_a?(Array) && !specific_keys.empty?
      specific_keys.each do |k|
        exp_k = File.expand_path(k)
        if File.file?(exp_k)
          system("SSH_AUTH_SOCK=\"#{agent_sock}\" ssh-add \"#{exp_k}\" >/dev/null 2>&1")
        end
      end
    else
      system("SSH_AUTH_SOCK=\"#{agent_sock}\" ssh-add >/dev/null 2>&1")
    end
    return agent_sock
  end

  nil
end

# Helper to automatically create and register a repo-scoped GitHub Deploy Key via gh CLI
def get_auto_deploy_key
  return nil unless command_exists?("git") && command_exists?("gh")

  remote_url = `git config --get remote.origin.url 2>/dev/null`.strip
  return nil if remote_url.empty?

  owner, repo = nil, nil
  if remote_url =~ %r{github\.com[:/]([^/]+)/([^/.]+)(\.git)?$}
    owner = $1
    repo = $2.sub(/\.git$/, '')
  end
  return nil unless owner && repo

  key_dir = File.expand_path("~/.sandbox/deploy_keys")
  FileUtils.mkdir_p(key_dir)
  key_path = File.join(key_dir, "#{owner}_#{repo}")

  if !File.file?(key_path)
    STDERR.puts "[bw] Creating dedicated GitHub Deploy Key for #{owner}/#{repo}..."
    if system("ssh-keygen -t ed25519 -f \"#{key_path}\" -N \"\" -C \"bw-auto-deploy-#{owner}-#{repo}\" >/dev/null 2>&1")
      STDERR.puts "[bw] Registering Deploy Key with GitHub repository via gh CLI..."
      title = "bw-auto-deploy-#{repo}"
      system("gh repo deploy-key add \"#{key_path}.pub\" -R \"#{owner}/#{repo}\" -w -t \"#{title}\" >/dev/null 2>&1")
    end
  end

  File.file?(key_path) ? key_path : nil
end

# Helper to verify required and recommended host tools on startup
def verify_installed_tools(is_default_tmux: true, skip_fail: false)
  tools = [
    { cmd: "bwrap", name: "Bubblewrap", desc: "Core sandbox container runtime", critical: true },
    { cmd: "tmux", name: "tmux", desc: "Default interactive session manager", critical: is_default_tmux },
    { cmd: "emacs", name: "Emacs", desc: "Default terminal text editor inside sandbox", critical: false },
    { cmd: "gh", name: "GitHub CLI (gh)", desc: "Automated Deploy Key registration", critical: false },
    { cmd: "git", name: "Git", desc: "Version control & repository detection", critical: false },
    { cmd: "ssh-agent", name: "ssh-agent", desc: "SSH authentication agent management", critical: false },
    { cmd: "quarto", name: "Quarto", desc: "Scientific and technical publishing system", critical: false },
    { cmd: "uv", name: "uv", desc: "Fast Python package and tool manager", critical: false }
  ]

  missing_critical = tools.select { |t| t[:critical] && !command_exists?(t[:cmd]) }
  missing_recommended = tools.select { |t| !t[:critical] && !command_exists?(t[:cmd]) }

  report_recommended = lambda do
    return if missing_recommended.empty?
    STDERR.puts "[bw] Warning: Recommended tool(s) missing on host:"
    missing_recommended.each do |t|
      STDERR.puts "  - #{t[:name]} (#{t[:cmd]}): #{t[:desc]}"
    end
    pkg_list = missing_recommended.map { |t| t[:cmd] == 'gh' ? 'gh' : (t[:cmd] == 'emacs' ? 'emacs-nox' : t[:cmd]) }.join(' ')
    STDERR.puts "  Install suggestion (Debian/Ubuntu): sudo apt-get install #{pkg_list}\n\n"
  end

  if missing_critical.any?
    STDERR.puts "Error: Required tool(s) missing on host:"
    missing_critical.each do |t|
      STDERR.puts "  - #{t[:name]} (#{t[:cmd]}): #{t[:desc]}"
    end
    if skip_fail
      # Inspection mode: report the gaps (including recommended) and continue without aborting.
      report_recommended.call
      return
    end
    STDERR.puts "\nPlease install missing required dependencies:"
    STDERR.puts "  Debian/Ubuntu: sudo apt-get install #{missing_critical.map { |t| t[:cmd] }.join(' ')}"
    STDERR.puts "  Fedora:        sudo dnf install #{missing_critical.map { |t| t[:cmd] }.join(' ')}"
    STDERR.puts "  Arch Linux:    sudo pacman -S #{missing_critical.map { |t| t[:cmd] }.join(' ')}"
    exit 1
  end

  report_recommended.call
end

# Helper to check if bwrap can set up unprivileged user namespaces and prompt to fix via AppArmor
def verify_bwrap_userns_support
  require 'open3'
  test_cmd = ["bwrap", "--ro-bind", "/", "/", "true"]
  _out, err_str, status = Open3.capture3(*test_cmd)

  return if status.success?

  STDERR.puts "Error: bubblewrap ('bwrap') cannot set up user namespaces."
  if !err_str.strip.empty?
    STDERR.puts "Detail: #{err_str.strip}"
  end
  STDERR.puts ""
  STDERR.puts "Cause: AppArmor or kernel sysctl restricts unprivileged user namespaces on this system."
  STDERR.puts "Solution (Option 2): Create an AppArmor profile for bubblewrap to allow unprivileged userns."
  STDERR.puts ""

  bwrap_path = `which bwrap`.strip
  bwrap_path = "/usr/bin/bwrap" if bwrap_path.empty?

  profile_path = "/etc/apparmor.d/bwrap"
  profile_content = <<~APPARMOR
    # AppArmor profile for bubblewrap sandbox
    abi <abi/4.0>,
    include <tunables/global>

    profile bwrap #{bwrap_path} flags=(unconfined) {
      userns,

      include if exists <local/bwrap>
    }
  APPARMOR

  if STDIN.tty?
    print "Would you like to automatically apply this fix now using sudo? [y/N]: "
    response = STDIN.gets&.strip&.downcase
    if response == "y" || response == "yes"
      puts "\nApplying AppArmor profile..."
      tmp_file = "/tmp/bwrap_apparmor_profile.tmp"
      File.write(tmp_file, profile_content)

      success = system("sudo cp #{tmp_file} #{profile_path} && sudo apparmor_parser -r #{profile_path}")
      FileUtils.rm_f(tmp_file)

      if success
        puts "AppArmor profile successfully installed and reloaded at #{profile_path}."
        puts "Re-testing bubblewrap..."
        _out2, _err2, retry_status = Open3.capture3(*test_cmd)
        if retry_status.success?
          puts "Bubblewrap userns permissions verified successfully!\n\n"
          return
        else
          STDERR.puts "Warning: AppArmor profile loaded, but bwrap test still failed."
        end
      else
        STDERR.puts "Error: Failed to install AppArmor profile via sudo."
      end
    end
  end

  STDERR.puts "\nTo manually fix this issue, run the following commands with sudo:"
  STDERR.puts "  sudo bash -c 'cat << \"EOF\" > #{profile_path}"
  profile_content.lines.each { |l| STDERR.puts "  " + l.chomp }
  STDERR.puts "  EOF'"
  STDERR.puts "  sudo apparmor_parser -r #{profile_path}\n\n"
  exit 1
end


# Remove single-line JSONC comments (// ... or # ...) while leaving string contents intact,
# so a '//' or '#' inside a string value is never mistaken for a comment.
def strip_jsonc_comments(content)
  out = +""
  in_str = false
  i = 0
  n = content.length
  while i < n
    c = content[i]
    nxt = content[i + 1]
    if in_str
      out << c
      if c == "\\"
        out << nxt if nxt
        i += 1
      elsif c == '"'
        in_str = false
      end
    elsif c == '"'
      in_str = true
      out << c
    elsif (c == "/" && nxt == "/") || c == "#"
      i += 1 until i >= n || content[i] == "\n"
      i -= 1
    else
      out << c
    end
    i += 1
  end
  out
end

# Helper to read a JSONC file, strip comments, and parse it.
# Raises a clear, actionable error (rather than a raw backtrace) on invalid content.
def load_jsonc(filepath)
  content = File.read(filepath)
  JSON.parse(strip_jsonc_comments(content))
rescue JSON::ParserError => e
  STDERR.puts "Error: Invalid JSON/JSONC in #{filepath}"
  STDERR.puts "  #{e.message}"
  STDERR.puts "Fix the file and re-run. (Comments must start with // or #.)"
  exit 1
end

# Placeholder token used in config file paths to stand in for the host home directory.
# An explicit, unlikely-in-practice token (instead of a magic absolute path) so that
# replacement is safe and predictable.
HOME_TOKEN = "@@HOME@@"

# Helper to recursively replace the HOME_TOKEN placeholder with the host home directory
def replace_sbox_prefix(obj, home_dir)
  if obj.is_a?(Hash)
    obj.each do |k, v|
      obj[k] = replace_sbox_prefix(v, home_dir)
    end
  elsif obj.is_a?(Array)
    obj.map! { |v| replace_sbox_prefix(v, home_dir) }
  elsif obj.is_a?(String)
    obj.gsub(HOME_TOKEN, home_dir)
  else
    obj
  end
end


