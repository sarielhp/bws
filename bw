def prepare_sandbox(config, sandbox, home_dir, config_dir)
  # Process global config "copy" list
  process_copy_paths(config["copy"], sandbox)

  # Copy models.json if it exists on host
  models_src = config.is_a?(Hash) && config["models_json_path"] ?
      File.expand_path(config["models_json_path"]) : File.expand_path("~/info/llm/models.json")
  copy_if_newer(models_src, File.join(sandbox, ".pi/agent/models.json"))

  # Copy resolv.conf (de-referencing symlink to prevent broken resolve inside sandbox)
  if File.file?("/etc/resolv.conf")
    content = File.read("/etc/resolv.conf")
    dest = File.join(sandbox, "etc/resolv.conf")
    copied = false
    if !File.exist?(dest) || File.read(dest) != content
      File.write(dest, content)
      copied = true
    end
    $copied_files << { src: "/etc/resolv.conf", dest: dest, copied: copied }
  end

  # Handle oh-my-posh prompt theming (if enabled in features)
  enable_omp = if config["features"].is_a?(Hash) && config["features"].key?("enable_oh_my_posh")
                 config["features"]["enable_oh_my_posh"]
               else
                 true
               end

  if enable_omp
    # Determine theme file location on host
    theme_source = if config["oh_my_posh"].is_a?(Hash) && config["oh_my_posh"]["theme_path"]
                     config["oh_my_posh"]["theme_path"]
                   else
                     File.join(config_dir, "theme.omp.json")
                   end
    theme_source = File.expand_path(theme_source)

    # Ensure default theme file exists on host if using default location and missing
    if !File.exist?(theme_source) && theme_source == File.join(config_dir, "theme.omp.json")
      FileUtils.mkdir_p(config_dir)
      File.write(theme_source, generate_default_theme)
    end

    if File.file?(theme_source)
      theme_dest = File.join(sandbox, ".mytheme.omp.json")
      copy_if_newer(theme_source, theme_dest)

      # Copy host oh-my-posh binary to sandbox bin if it exists in ~/bin
      omp_host_bin = File.expand_path("~/bin/oh-my-posh")
      copy_if_newer(omp_host_bin, File.join(sandbox, "bin/oh-my-posh")) if File.file?(omp_host_bin)

      # Ensure oh-my-posh is initialized in sandbox shell profiles
      sandbox_theme = "#{home_dir}/.mytheme.omp.json"
      inject_oh_my_posh(File.join(sandbox, ".bashrc"), "bash", sandbox_theme)
      if File.exist?(File.join(sandbox, ".zshrc"))
        inject_oh_my_posh(File.join(sandbox, ".zshrc"), "zsh", sandbox_theme)
      end
    end
  end

  # Ensure custom bin paths are in PATH and the configured editor is set in the
  # sandbox's shell configurations. Values are derived from config so they never drift.
  sandbox_paths = if config["path"].is_a?(Array)
                    config["path"].select { |p| p.is_a?(String) }.map { |p| p.start_with?("~") ? p.gsub(/^~/, home_dir.to_s) : p }
                  else
                    []
                  end

  editor = (config["env"].is_a?(Hash) && config["env"]["EDITOR"]) || "emacs -nw"
  visual = (config["env"].is_a?(Hash) && config["env"]["VISUAL"]) || editor

  path_line = sandbox_paths.any? ? "export PATH=\"#{sandbox_paths.join(':')}:$PATH\"" : nil
  editor_block = "export EDITOR=\"#{editor}\"\nexport VISUAL=\"#{visual}\""

  [".bashrc", ".zshrc"].each do |rc_name|
    rc_path = File.join(sandbox, rc_name)
    next unless rc_name == ".bashrc" || File.exist?(rc_path)
    FileUtils.touch(rc_path)
    text = File.read(rc_path)
    original = text

    if path_line
      if text.include?("# Add sandbox-specific binary paths")
        text = text.sub(/# Add sandbox-specific binary paths\nexport PATH="[^"]*"\n?/, "# Add sandbox-specific binary paths\n#{path_line}\n")
      else
        text += "\n# Add sandbox-specific binary paths\n#{path_line}\n"
      end
    end

    if text.include?("# sandbox default editor")
      text = text.sub(/# sandbox default editor\nexport EDITOR="[^"]*"\nexport VISUAL="[^"]*"\n?/, "# sandbox default editor\n#{editor_block}\n")
    else
      text += "\n# sandbox default editor\n#{editor_block}\n"
    end

    File.write(rc_path, text) unless text == original
  end

  # Ensure login shells source .bashrc by creating/updating .bash_profile and .profile
  [".bash_profile", ".profile"].each do |profile_name|
    profile_path = File.join(sandbox, profile_name)
    FileUtils.touch(profile_path)
    content = File.read(profile_path)
    unless content.include?(".bashrc")
      File.open(profile_path, "a") do |f|
        f.puts "\n# Include .bashrc if it exists"
        f.puts "if [ -f \"$HOME/.bashrc\" ]; then"
        f.puts "  . \"$HOME/.bashrc\""
        f.puts "fi"
      end
    end
  end

  # (Startup-banner echo lines were removed to keep the interactive shell prompt clean.)

  # Set up .tmux.conf in the sandbox (copy host config as base if newer or missing, then append status indicator)
  tmux_conf = File.join(sandbox, ".tmux.conf")
  host_tmux = File.expand_path("~/.tmux.conf")
  needs_bubble = false

  if File.file?(host_tmux)
    copied = false
    if !File.exist?(tmux_conf) || File.mtime(host_tmux) > File.mtime(tmux_conf)
      FileUtils.cp(host_tmux, tmux_conf)
      FileUtils.chmod("+w", tmux_conf)
      needs_bubble = true
      copied = true
    end
    $copied_files << { src: host_tmux, dest: tmux_conf, copied: copied }
  elsif !File.exist?(tmux_conf)
    FileUtils.touch(tmux_conf)
    FileUtils.chmod("+w", tmux_conf)
    needs_bubble = true
    $copied_files << { src: "<empty>", dest: tmux_conf, copied: true }
  end

  if needs_bubble || (File.exist?(tmux_conf) && !File.read(tmux_conf).include?("BUBBLE"))
    FileUtils.chmod("+w", tmux_conf)
    File.open(tmux_conf, "a") do |f|
      f.puts "\n# Sandbox indicator in status bar"
      f.puts "set -g status-left-length 20"
      f.puts "set -g status-left \"#[fg=white,bg=purple,bold] BUBBLE #[default] \""
      f.puts "set -g status-style bg=colour234,fg=colour137"
    end
  end

  # Ensure cdtoday function is defined in the sandbox's shell configurations
  cdtoday_base = config.is_a?(Hash) && config["cdtoday"] ? config["cdtoday"].to_s : "info/misc"
  inject_cdtoday(File.join(sandbox, ".bashrc"), cdtoday_base)
  if File.exist?(File.join(sandbox, ".zshrc"))
    inject_cdtoday(File.join(sandbox, ".zshrc"), cdtoday_base)
  end

end

begin
  # Perform all sandbox write/setup side effects (skipped on --info dry run).
  prepare_sandbox(config, sandbox, home_dir, config_dir) unless show_info
  # Base bubblewrap arguments initialized dynamically from the parsed configuration
  bwrap_args = ["--tmpfs", "/etc"]

  # 1. Parse system flags
  if config["system"]
    bwrap_args << "--share-net" if config["system"]["share_net"]
    bwrap_args << "--clearenv" if config["system"]["clearenv"]
    bwrap_args << "--unshare-uts" if config["system"]["unshare_uts"]
    if config["system"]["hostname"]
      bwrap_args.concat(["--hostname", config["system"]["hostname"]])
    end
  end

  # 2. Parse binds_rw
  apply_binds_list(bwrap_args, config["binds_rw"], ro: false)

  # 3. Parse binds_ro
  apply_binds_list(bwrap_args, config["binds_ro"], ro: true)

  # 4. Parse environment variables
  # Note: a non-empty host value intentionally overrides the configured default (so e.g.
  # TERM/LANG follow the host). Use the sandboxed values below as fallbacks only.
  if config["env"].is_a?(Hash)
    config["env"].each do |k, default_val|
      default_val = default_val.to_s if default_val
      val = (ENV[k].is_a?(String) && !ENV[k].empty?) ? ENV[k] : default_val
      if k == "LC_ALL" && (!ENV["LC_ALL"] || ENV["LC_ALL"].empty?)
        val = ENV["LANG"] || default_val
      elsif k == "LOGNAME" && (!ENV["LOGNAME"] || ENV["LOGNAME"].empty?)
        val = ENV["USER"] || default_val
      end
      if val.is_a?(String) && !val.empty?
        bwrap_args.concat(["--setenv", k, val])
      end
    end
  end

  # Pass OPENROUTER_API_KEY from host environment if present and not already handled in config["env"]
  if ENV["OPENROUTER_API_KEY"] && !ENV["OPENROUTER_API_KEY"].empty? && (!config["env"].is_a?(Hash) || !config["env"].key?("OPENROUTER_API_KEY"))
    bwrap_args.concat(["--setenv", "OPENROUTER_API_KEY", ENV["OPENROUTER_API_KEY"]])
  end

  # 5. Parse and concatenate PATH directories
  if config["path"].is_a?(Array)
    resolved_paths = config["path"].select { |p| p.is_a?(String) }.map do |p|
      p.start_with?("~") ? p.gsub(/^~/, home_dir.to_s) : p
    end
    bwrap_args.concat(["--setenv", "PATH", resolved_paths.join(":")])
  end

  # 6. Parse features (SSH, X11, automatic ETC mapping)
  if config["features"]
    if config["features"]["enable_ssh"]
      ssh_keys = config["features"]["ssh_keys"]
      if show_info
        # Dry run: never create deploy keys or spawn an ssh-agent; only reuse an
        # already-running agent socket so the displayed plan stays side-effect free.
        ssh_auth_sock = ENV["SSH_AUTH_SOCK"] if ENV["SSH_AUTH_SOCK"] && File.socket?(ENV["SSH_AUTH_SOCK"])
      else
        if (ssh_keys.nil? || ssh_keys.empty?) && config["features"].fetch("auto_repo_deploy_key", true) && command_exists?("ssh-agent") && command_exists?("ssh-add")
          auto_key = get_auto_deploy_key
          ssh_keys = [auto_key] if auto_key
        end
        ssh_auth_sock = ensure_ssh_agent(ssh_keys)
      end
      host_ssh_dir = File.expand_path("~/.ssh")
      sandbox_ssh = "#{home_dir}/.ssh"

      if ssh_auth_sock && File.socket?(ssh_auth_sock)
        # Safe method: Forward SSH agent socket only. Private key files are NOT exposed.
        bwrap_args.concat(["--bind", ssh_auth_sock, ssh_auth_sock])
        bwrap_args.concat(["--setenv", "SSH_AUTH_SOCK", ssh_auth_sock])

        # Bind non-secret config and known_hosts files if they exist.
        # config is mounted read-only (ssh only reads it, and a sandbox process must not be
        # able to rewrite the host's ~/.ssh/config); known_hosts stays writable so ssh can
        # record newly-verified host keys.
        if File.directory?(host_ssh_dir)
          FileUtils.mkdir_p(File.join(sandbox, ".ssh")) unless show_info
          if File.exist?(File.join(host_ssh_dir, "config"))
            bwrap_args.concat(["--ro-bind", File.join(host_ssh_dir, "config"), "#{sandbox_ssh}/config"])
          end
          if File.exist?(File.join(host_ssh_dir, "known_hosts"))
            bwrap_args.concat(["--bind", File.join(host_ssh_dir, "known_hosts"), "#{sandbox_ssh}/known_hosts"])
          end
        end
      elsif File.directory?(host_ssh_dir)
        # Fallback when no agent socket is running: expose only non-secret SSH files.
        # Private keys are intentionally NOT mounted (sandbox processes could read them).
        FileUtils.mkdir_p(File.join(sandbox, ".ssh")) unless show_info
        ["config", "known_hosts"].each do |f|
          host_f = File.join(host_ssh_dir, f)
          next unless File.exist?(host_f)
          # Already bound (read-write) via binds_rw; don't override it or duplicate the mount.
          next if bwrap_args.include?(host_f)
          bwrap_args.concat(["--ro-bind", host_f, "#{sandbox_ssh}/#{f}"])
        end
      end
    end

    if config["features"]["enable_x11"]
      display = ENV["DISPLAY"]
      if display
        bwrap_args.concat(["--setenv", "DISPLAY", display])
        # NOTE: the host X11 socket mount (/tmp/.X11-unix) is intentionally NOT bound here.
        #       It must be mounted AFTER the per-instance /tmp bind below, otherwise the
        #       fresh /tmp would mask the socket and break X11 apps.

        xauth = ENV["XAUTHORITY"] || File.expand_path("~/.Xauthority")
        if File.exist?(xauth)
          bwrap_args.concat(["--ro-bind", xauth, "#{home_dir}/.Xauthority"])
          bwrap_args.concat(["--setenv", "XAUTHORITY", "#{home_dir}/.Xauthority"])
        end

        # Bind user XDG runtime directory (/run/user/UID) for DBus, AT-SPI, and GTK/Qt GUI sockets
        uid = Process.uid
        user_run_dir = ENV['XDG_RUNTIME_DIR'] || "/run/user/#{uid}"
        if Dir.exist?(user_run_dir)
          bwrap_args.concat(["--bind-try", user_run_dir, user_run_dir])
          bwrap_args.concat(["--setenv", "XDG_RUNTIME_DIR", user_run_dir])
        end

        # Suppress GTK accessibility bus connection warnings
        bwrap_args.concat(["--setenv", "NO_AT_SPI", "1"])
      end
    end

    if config["features"]["enable_etc_auto_bind"]
      Dir.glob("/etc/*").each do |item|
        filename = File.basename(item)
        if filename != "resolv.conf"
          bwrap_args.concat(["--ro-bind-try", item, "/etc/#{filename}"])
        end
      end
    end
  end

  # Auto-bind /opt and Quarto installation path if available on host
  if File.exist?("/opt") && !bwrap_args.include?("/opt")
    bwrap_args.concat(["--ro-bind-try", "/opt", "/opt"])
    opt_real = File.realpath("/opt") rescue "/opt"
    if opt_real != "/opt" && File.exist?(opt_real) && !bwrap_args.include?(opt_real)
      bwrap_args.concat(["--ro-bind-try", opt_real, opt_real])
    end
  end

  if command_exists?("quarto")
    quarto_cmd = `which quarto 2>/dev/null`.strip
    if !quarto_cmd.empty? && File.exist?(quarto_cmd)
      real_path = File.realpath(quarto_cmd) rescue quarto_cmd
      quarto_bin_dir = File.dirname(real_path)
      quarto_root = File.dirname(quarto_bin_dir)
      if File.directory?(quarto_root) && !bwrap_args.include?(quarto_root)
        bwrap_args.concat(["--ro-bind-try", quarto_root, quarto_root])
      end
      if File.directory?(quarto_bin_dir) && !bwrap_args.include?(quarto_bin_dir)
        bwrap_args.concat(["--ro-bind-try", quarto_bin_dir, quarto_bin_dir])
      end
    end
  end

  # Calculate sandbox PWD relative to host PWD
  sandbox_pwd = current_dir.to_s

  # Bind sandbox PWD and general temp/special files
  bwrap_args.concat([
    "--bind", host_tmp, "/tmp",
    "--proc", "/proc",
    "--dev", "/dev",
    "--ro-bind-try", "/sys", "/sys",
    "--die-with-parent",
    "--bind", current_dir.to_s, sandbox_pwd,
    "--chdir", sandbox_pwd
  ])

  # Mount the host X11 socket AFTER the /tmp bind so the per-instance /tmp does not mask it.
  x11_enabled = config["features"].is_a?(Hash) && config["features"]["enable_x11"]
  if x11_enabled && ENV["DISPLAY"]
    bwrap_args.concat(["--ro-bind-try", "/tmp/.X11-unix", "/tmp/.X11-unix"])
  end

  # Bind the custom resolv.conf into the writeable /etc tmpfs
  sandbox_resolv = File.join(sandbox, "etc/resolv.conf")
  if File.file?(sandbox_resolv)
    bwrap_args.concat(["--ro-bind", sandbox_resolv, "/etc/resolv.conf"])
  end

  # Load and process the local directory configuration (.bw.jsonc) if it exists
  local_config_path = File.join(current_dir.to_s, ".bw.jsonc")
  if File.exist?(local_config_path)
    STDERR.puts "Loading configuration file: #{local_config_path}"
    local_config = load_jsonc(local_config_path)
    local_config = replace_sbox_prefix(local_config, Dir.home)
    process_bw_jsonc(local_config, sandbox, bwrap_args, dry_run: show_info)
  end

  # Execution arguments logic
  exec_args = if test_opencode
                ["opencode", "debug", "info"]
              elsif test_quarto
                ["quarto", "--version"]
              elsif test_uv
                ["uv", "--version"]
              elsif ARGV.empty?
                # Force tmux to run in UTF-8 mode (-u) to prevent line-wrapping/overwrite glitches
                session_name = config.is_a?(Hash) && config["tmux_session_name"] ?
                    config["tmux_session_name"] : "bwrap-dev"
                ["tmux", "-u", "new-session", "-A", "-s", session_name]
              else
                ARGV
              end

  # Run bubblewrap with the assembled arguments
  if show_info
    copy_list = config["copy"].is_a?(Array) ? config["copy"] : []
    print_info(bwrap_args, exec_args, global_config_path, local_config_path, copy_list,
               config["system"].is_a?(Hash) ? config["system"] : {}, current_dir.to_s)
    exit 0
  end

  if test_opencode
    require 'open3'
    output, status = Open3.capture2e("bwrap", *bwrap_args, *exec_args)
    if status.success?
      puts "Everything is fine."
      exit 0
    else
      STDERR.puts "Test failed: opencode did not load correctly."
      STDERR.puts "Detail:"
      STDERR.puts output
      exit status.exitstatus || 1
    end
  elsif test_quarto
    require 'open3'
    output, status = Open3.capture2e("bwrap", *bwrap_args, *exec_args)
    if status.success?
      puts "Quarto version inside sandbox: #{output.strip}"
      puts "Everything is fine."
      exit 0
    else
      STDERR.puts "Test failed: quarto did not load correctly."
      STDERR.puts "Detail:"
      STDERR.puts output
      exit status.exitstatus || 1
    end
  elsif test_uv
    require 'open3'
    output_uv, status_uv = Open3.capture2e("bwrap", *bwrap_args, "uv", "--version")
    output_uvx, status_uvx = Open3.capture2e("bwrap", *bwrap_args, "uvx", "--version")
    if status_uv.success? && status_uvx.success?
      puts "uv version inside sandbox: #{output_uv.strip}"
      puts "uvx version inside sandbox: #{output_uvx.strip}"
      puts "Everything is fine."
      exit 0
    else
      STDERR.puts "Test failed: uv or uvx did not load correctly."
      STDERR.puts "uv output: #{output_uv}" unless status_uv.success?
      STDERR.puts "uvx output: #{output_uvx}" unless status_uvx.success?
      exit(status_uv.exitstatus || status_uvx.exitstatus || 1)
    end
  else
    success = system("bwrap", *bwrap_args, *exec_args)
    exit_code = success ? 0 : ($?.exitstatus || 1)
    exit exit_code
  end

ensure
  # Clean up host temporary directory (never on --info: host_tmp is only a placeholder)
  unless show_info
    FileUtils.rm_rf(host_tmp) if host_tmp && Dir.exist?(host_tmp)
  end
end


