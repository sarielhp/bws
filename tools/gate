#!/usr/bin/env ruby
# frozen_string_literal: true

require 'open3'

def run_step(name, cmd)
  puts "=== #{name} ==="
  system(cmd) || abort("Gate check failed: #{name}")
end

run_step('verify_build', './tools/verify_build.sh')
run_step('audit_lines', './tools/audit_lines.rb')
puts "\nQuality gate passed cleanly."
