#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

BIN_DIR="${HOME}/bin"
mkdir -p "$BIN_DIR"

echo "=== Building bws ==="
rm -f "$BIN_DIR/bws" "$BIN_DIR/bw"
go build -o "$BIN_DIR/bws" .
echo ""

echo "Installed bws to $BIN_DIR/bws"
ls -la "$BIN_DIR/bws"

# Install Antigravity global skill if ~/.gemini/config exists
if [ -d "${HOME}/.gemini/config" ]; then
    mkdir -p "${HOME}/.gemini/config/skills"
    rm -rf "${HOME}/.gemini/config/skills/bws"
    cp -r "${ROOT}/integrations/skills/bws" "${HOME}/.gemini/config/skills/bws"
    echo "Installed Antigravity skill to ~/.gemini/config/skills/bws"
fi

# Install OpenCode commands if ~/.config/opencode exists
if [ -d "${HOME}/.config/opencode" ]; then
    mkdir -p "${HOME}/.config/opencode/command"
    cp -r "${ROOT}/integrations/opencode/command/"* "${HOME}/.config/opencode/command/"
    echo "Installed OpenCode slash commands to ~/.config/opencode/command/"
fi