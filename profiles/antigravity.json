{
  "name": "antigravity",
  "description": "Google Antigravity CLI and coding agent framework",
  "path": [
    "@@HOME@@/.local/bin",
    "@@HOME@@/bin"
  ],
  "binds_rw": [
    [
      "~/.gemini",
      "@@HOME@@/.gemini"
    ],
    [
      "~/.config/antigravity",
      "@@HOME@@/.config/antigravity"
    ]
  ],
  "tests": [
    {
      "name": "Antigravity CLI version",
      "cmd": [
        "agy",
        "--version"
      ],
      "type": "version",
      "optional": true
    }
  ]
}
