{
  "name": "claude",
  "aliases": [
    "claude-code",
    "anthropic"
  ],
  "description": "Anthropic Claude Code CLI assistant, runtime, and caches",
  "detect": {
    "files": [
      "CLAUDE.md",
      ".claude",
      ".claude.json"
    ]
  },
  "path": [
    "@@HOME@@/.local/bin",
    "@@HOME@@/bin",
    "@@HOME@@/.local/share/claude/versions"
  ],
  "pass_env": [
    "ANTHROPIC_API_KEY",
    "ANTHROPIC_AUTH_TOKEN",
    "ANTHROPIC_BASE_URL",
    "ANTHROPIC_MODEL",
    "ANTHROPIC_SMALL_MODEL",
    "ANTHROPIC_*",
    "CLAUDE_*"
  ],
  "binds_rw": [
    [
      "~/.claude",
      "@@HOME@@/.claude"
    ],
    [
      "~/.claude.json",
      "@@HOME@@/.claude.json"
    ],
    [
      "~/.config/claude",
      "@@HOME@@/.config/claude"
    ],
    [
      "~/.local/share/claude",
      "@@HOME@@/.local/share/claude"
    ],
    [
      "~/.local/state/claude",
      "@@HOME@@/.local/state/claude"
    ],
    [
      "~/.cache/claude",
      "@@HOME@@/.cache/claude"
    ]
  ],
  "tests": [
    {
      "name": "Claude Code version",
      "cmd": [
        "claude",
        "--version"
      ],
      "type": "version",
      "optional": true
    },
    {
      "name": "Claude Code doctor check",
      "cmd": [
        "claude",
        "doctor"
      ],
      "type": "smoke",
      "optional": true
    }
  ],
  "features": {
    "enable_proxy": true,
    "enable_dbus": true
  }
}
