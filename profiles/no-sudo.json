{
  "name": "no-sudo",
  "description": "Mask privilege escalation binaries, superuser tools, and sudoers configuration",
  "mask": [
    "/usr/bin/sudo",
    "/bin/sudo",
    "/usr/bin/su",
    "/bin/su",
    "/usr/bin/pkexec",
    "/bin/pkexec",
    "/usr/bin/doas",
    "/bin/doas",
    "/usr/bin/gpasswd",
    "/bin/gpasswd",
    "/usr/bin/newgrp",
    "/bin/newgrp",
    "/etc/sudoers",
    "/etc/sudoers.d"
  ],
  "tests": [
    {
      "name": "sudo binary is blocked",
      "cmd": [
        "bash",
        "-c",
        "! sudo 2>/dev/null"
      ],
      "type": "smoke"
    },
    {
      "name": "su binary is blocked",
      "cmd": [
        "bash",
        "-c",
        "! su 2>/dev/null"
      ],
      "type": "smoke"
    },
    {
      "name": "pkexec binary is blocked",
      "cmd": [
        "bash",
        "-c",
        "! pkexec 2>/dev/null"
      ],
      "type": "smoke"
    },
    {
      "name": "doas binary is blocked",
      "cmd": [
        "bash",
        "-c",
        "! doas 2>/dev/null"
      ],
      "type": "smoke"
    },
    {
      "name": "gpasswd binary is blocked",
      "cmd": [
        "bash",
        "-c",
        "! gpasswd 2>/dev/null"
      ],
      "type": "smoke"
    },
    {
      "name": "newgrp binary is blocked",
      "cmd": [
        "bash",
        "-c",
        "! newgrp 2>/dev/null"
      ],
      "type": "smoke"
    },
    {
      "name": "sudoers file is masked",
      "cmd": [
        "bash",
        "-c",
        "! test -s /etc/sudoers"
      ],
      "type": "smoke"
    }
  ]
}
