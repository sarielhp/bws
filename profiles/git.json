{
  "name": "git",
  "description": "Git distributed version control system",
  "detect": {
    "files": [
      ".git",
      ".gitignore",
      ".gitmodules"
    ]
  },
  "binds_ro": [
    [
      "~/.gitconfig",
      "@@HOME@@/.gitconfig"
    ],
    [
      "~/.git-credentials",
      "@@HOME@@/.git-credentials"
    ]
  ],
  "tests": [
    {
      "name": "Git binary version",
      "cmd": [
        "git",
        "--version"
      ],
      "type": "version"
    }
  ],
  "pass_env": [
    "GIT_AUTHOR_NAME",
    "GIT_AUTHOR_EMAIL",
    "GIT_COMMITTER_NAME",
    "GIT_COMMITTER_EMAIL"
  ]
}
